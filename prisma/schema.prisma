// Datasource provider is managed by scripts/prepare-db.mjs:
// "postgresql" when DATABASE_URL is a postgres URL, "sqlite" otherwise.
// Enums are modeled as String fields (validated by Zod at every boundary)
// so the same schema works on both providers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  displayName   String?
  major         String?
  year          String?
  createdAt     DateTime  @default(now())
  isModerator   Boolean   @default(false) // gates the moderation queue
  // Role is a String (not a native Prisma enum) so the schema still works on
  // SQLite locally — Prisma enums are Postgres-only. Values: USER | MODERATOR.
  role          String    @default("USER")
  emailOptOut   Boolean   @default(false) // single opt-out for activity emails

  listings        Listing[]
  searchEvents    SearchEvent[]
  messages        Message[]
  startedThreads  Conversation[] @relation("ConversationStarter")
  ratingsGiven    Rating[]  @relation("RatingsGiven")
  ratingsReceived Rating[]  @relation("RatingsReceived")
  accounts        Account[]
  sessions        Session[]
  favorites       Favorite[]
  savedSearches   SavedSearch[]
  notifications   Notification[]
  reportsMade     Report[]  @relation("ReportsMade")
  blocksInitiated Block[]   @relation("BlocksInitiated")
  blocksReceived  Block[]   @relation("BlocksReceived")
}

// type: SELL | DONATE | LOST | FOUND
// status: ACTIVE | SOLD | RESOLVED | DELETED
model Listing {
  id           String   @id @default(cuid())
  type         String
  title        String
  description  String
  category     String
  condition    String?
  price        Float?
  status       String   @default("ACTIVE")
  locationNote String?
  photos       Json     @default("[]")
  ownerId      String
  viewCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Set when the listing transitions to SOLD/RESOLVED — powers accurate
  // time-to-completion analytics (updatedAt changes on any edit).
  completedAt  DateTime?
  // Move-out mode groups bulk-posted items under one shareable batch id.
  moveoutBatchId String?
  // Last price we notified favoriters about, so a drop fires at most once per new low.
  lastNotifiedPrice Float?

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  ratings       Rating[]
  favorites     Favorite[]
  reports       Report[]

  @@index([type, status, category, createdAt])
  @@index([type, category, status]) // category-demand + funnel aggregates
  @@index([status, completedAt]) // time-to-completion + completed-in-range
  @@index([ownerId])
  @@index([moveoutBatchId])
}

// Lightweight, fire-and-forget analytics row written on each Browse search /
// category filter. Powers the moderator-only /funnel dashboard. `tab` is one
// of: Marketplace | Donations | LostFound | Wanted.
model SearchEvent {
  id          String   @id @default(cuid())
  query       String
  category    String?
  tab         String
  resultCount Int
  userId      String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([query])
  @@index([resultCount]) // zero-result lookups
}

model Conversation {
  id             String   @id @default(cuid())
  listingId      String
  // JSON array of the two participant user ids. SQLite can't filter inside
  // Json columns, so starterId (the non-owner participant) is also stored
  // as a queryable scalar; the owner side is reachable via listing.ownerId.
  participantIds Json
  starterId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  starter  User      @relation("ConversationStarter", fields: [starterId], references: [id], onDelete: Cascade)
  messages Message[]

  // One thread per buyer per listing — "Message seller" reopens the thread.
  @@unique([listingId, starterId])
  @@index([listingId])
}

// kind: TEXT | MEETUP_PROPOSAL | CLAIM
// meta: MEETUP_PROPOSAL -> { spot, datetime, status: PENDING|ACCEPTED|DECLINED }
//       CLAIM           -> { detail, status: PENDING|APPROVED|DENIED }
model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  kind           String    @default("TEXT")
  meta           Json?
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Rating {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  listingId  String
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())

  fromUser User    @relation("RatingsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User    @relation("RatingsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, listingId])
  @@index([toUserId])
}

// ---- V2: engagement, discovery, trust & safety ----

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  label     String
  // Criteria mirror the browse params; matching runs in app code at post time.
  q        String?
  category String?
  type     String? // SELL | DONATE | LOST | FOUND | WANTED | null = any
  minPrice Float?
  maxPrice Float?
  notify   Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String // recipient
  // kind: MESSAGE | CLAIM | MEETUP | RATING | SAVED_SEARCH_HIT | PRICE_DROP | FAVORITE_SOLD | REPORT_RESOLVED
  kind      String
  title     String
  body      String?
  href      String // internal path
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  listingId      String?
  reportedUserId String?
  // reason: SPAM | PROHIBITED | HARASSMENT | SCAM | OTHER
  reason         String
  detail         String?
  // status: OPEN | REVIEWED | ACTIONED | DISMISSED
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())

  reporter User     @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  listing  Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ---- NextAuth (Auth.js) models ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
