# Database — leave unset (or set to a SQLite file URL) for local dev.
# For production, set a Postgres connection string; `npm run db:prepare`
# flips the Prisma provider automatically.
#
# On serverless (Vercel), use the POOLED Neon connection string (the "-pooler"
# host) with a small connection limit so concurrent function instances don't
# exhaust Postgres connections under burst (e.g. move-in/move-out):
#   DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1"
# Keep the direct (non-pooler) URL for migrations only.
# DATABASE_URL="postgresql://user:pass@host:5432/db"
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Email — enables REAL @uc.edu magic-link sign-up. When unset, the real sign-in
# form is hidden in production (only demo login shows); in dev, magic links are
# printed to the server console so you can still sign in.
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="2nd Time Around <no-reply@example.com>"

# Showcase sign-in (demo account); unset to disable /demo
# DEMO_PASSWORD="pick-something"

# Rate limiting (optional). When BOTH are set, limiting is distributed via
# Upstash Redis. When absent, the app falls back to per-instance in-memory
# limiting — fine for local/dev, and non-fatal in production (a startup warning
# is logged). Setting these later upgrades to distributed limiting with no code
# change. Create a free database at https://console.upstash.com/redis
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"
